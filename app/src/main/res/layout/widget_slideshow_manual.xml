<?xml version="1.0" encoding="utf-8"?>
<!--
  Long intervals and "tap only": the flipper doesn't advance on its own. The (non-wakeup) alarm or a
  tap tells it which photo to show, and the launcher requests that photo when it draws the widget,
  i.e. only while the home screen is visible.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <AdapterViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="false"
        android:loopViews="true"
        android:inAnimation="@animator/fade_in"
        android:outAnimation="@animator/fade_out" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/empty_bg"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/no_photos_found"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</FrameLayout>
