<?xml version="1.0" encoding="utf-8"?>
<!--
  The photo sits inside a FrameLayout: on Android 15+ it gets a tap handler carrying its position
  (setOnClickFillInIntent). If the photo were the item's root, Android would hand the tap over to
  AdapterViewFlipper, which ignores it, and the widget wouldn't know which photo was tapped.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/item_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/photo_description" />
</FrameLayout>
