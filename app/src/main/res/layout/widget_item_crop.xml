<?xml version="1.0" encoding="utf-8"?>
<!--
  La foto va dentro de un FrameLayout: en Android 15+ se le pone el toque con su posición
  (setOnClickFillInIntent). Si la foto fuera la raíz del elemento, Android dejaría el toque en
  manos de AdapterViewFlipper, que no lo atiende, y el widget no sabría qué foto se tocó.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/item_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/photo_description" />
</FrameLayout>
