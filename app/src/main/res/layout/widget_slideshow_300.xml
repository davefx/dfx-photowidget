<?xml version="1.0" encoding="utf-8"?>
<!--
  Slideshow every 300 s. The launcher animates it, and AdapterViewFlipper stops on its own
  when the screen is off or locked, or another app is in front. Generated: one layout per interval,
  because flipInterval can only be set reliably from XML.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <AdapterViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:loopViews="true"
        android:flipInterval="300000"
        android:inAnimation="@animator/fade_in"
        android:outAnimation="@animator/fade_out" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/empty_bg"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/no_photos_found"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</FrameLayout>
